# Microsoft Entra / Security API Credentials
APOCALYPSE_TENANT_ID=your-tenant-id
APOCALYPSE_CLIENT_ID=your-client-id
APOCALYPSE_CLIENT_SECRET=do-not-commit-this
APOCALYPSE_LOOKBACK_HOURS=24
APOCALYPSE_MAX_RECORDS=100

# Groq AI Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Optional Endpoints
APOCALYPSE_SENTINEL_URL=
APOCALYPSE_DEFENDER_URL=https://api.security.microsoft.com/api/incidents